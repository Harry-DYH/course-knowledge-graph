      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "深度优先遍历",
        "description": "也称深度优先搜索（DFS），体现“先走到尽头，再回溯继续”的遍历方式，通常基于递归实现，也可基于迭代实现。"
      }
    },
    {
      "id": "4:ac9ee535-5b37-44b2-a5d5-9955bff616ea:44",
      "labels": [
