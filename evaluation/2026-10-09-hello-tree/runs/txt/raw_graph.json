      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "平衡二叉树",
        "description": "任意节点的左子树和右子树的高度之差的绝对值不超过1"
      }
    },
    {
      "id": "4:ac9ee535-5b37-44b2-a5d5-9955bff616ea:36",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "高度",
        "description": "教材可能会将其定义为经过的节点的数量，此时高度和深度都需要加1"
      }
    },
    {
