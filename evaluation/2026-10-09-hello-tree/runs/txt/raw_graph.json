      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "二叉树的退化",
        "description": "当所有节点都偏向一侧时，二叉树退化为链表；各项操作变为线性操作，时间复杂度退化至O(n)"
      }
    },
