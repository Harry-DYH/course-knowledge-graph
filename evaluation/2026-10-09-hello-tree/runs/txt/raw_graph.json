      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "队列",
        "description": "遵循先进先出规则的数据结构，用于实现广度优先遍历"
      }
    },
    {
      "id": "4:ac9ee535-5b37-44b2-a5d5-9955bff616ea:40",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "广度优先遍历",
        "description": "也称广度优先搜索（BFS），体现一圈一圈向外扩展的逐层遍历方式，通常借助队列实现"
      }
    },
