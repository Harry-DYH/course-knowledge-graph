      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "链表表示",
        "description": "二叉树的存储单元为节点 TreeNode，节点之间通过指针相连接。"
      }
    },
    {
      "id": "4:ac9ee535-5b37-44b2-a5d5-9955bff616ea:51",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "Treenode",
        "description": "链表表示下二叉树的存储单元节点。"
      }
    },
    {
      "id": "4:ac9ee535-5b37-44b2-a5d5-9955bff616ea:46",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "递归",
        "description": "深度优先搜索通常基于递归实现，递归过程可分为“递”和“归”两个逆向部分。"
      }
    },
    {
      "id": "4:ac9ee535-5b37-44b2-a5d5-9955bff616ea:49",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "映射公式",
        "description": "若某节点索引为 i，则左子节点索引为 2i+1，右子节点索引为 2i+2，作用相当于链表中的节点引用（指针）。"
      }
    },
    {
      "id": "4:ac9ee535-5b37-44b2-a5d5-9955bff616ea:48",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "二叉树数组表示",
        "description": "用数组来表示二叉树，将节点按层序遍历顺序存储，每个节点对应唯一数组索引。"
      }
    },
    {
      "id": "4:ac9ee535-5b37-44b2-a5d5-9955bff616ea:52",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "层序遍历序列",
        "description": "按层序遍历二叉树得到的序列；显式写出所有None后可唯一表示二叉树。"
      }
    },
    {
      "id": "4:ac9ee535-5b37-44b2-a5d5-9955bff616ea:54",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "二叉搜索树",
        "description": "满足左子树所有节点值 < 根节点值 < 右子树所有节点值的二叉树，且任意节点的左右子树也是二叉搜索树"
      }
    },
    {
      "id": "4:ac9ee535-5b37-44b2-a5d5-9955bff616ea:53",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "二叉树的数组表示",
        "description": "使用数组存储二叉树的方法；完全二叉树适合使用数组表示，可省略存储所有None。"
      }
    },
    {
      "id": "4:ac9ee535-5b37-44b2-a5d5-9955bff616ea:60",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "删除节点",
        "description": "先在二叉树中查找到目标节点，再将其删除，删除后需保证二叉搜索树性质"
      }
    },
    {
      "id": "4:ac9ee535-5b37-44b2-a5d5-9955bff616ea:57",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "查找节点",
        "description": "给定目标节点值 num，从根节点 root 出发循环比较 cur.val 与 num：cur.val < num 则 cur = cur.right；cur.val > num 则 cur = cur.left；cur.val = num 则找到目标节点并返回"
      }
    },
    {
      "id": "4:ac9ee535-5b37-44b2-a5d5-9955bff616ea:56",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "二叉搜索树的操作",
        "description": "将二叉搜索树封装为类 BinarySearchTree，声明成员变量 root 指向根节点，包含查找、插入、删除等操作"
      }
    },
    {
      "id": "4:ac9ee535-5b37-44b2-a5d5-9955bff616ea:58",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "二分查找算法",
        "description": "每轮排除一半情况的查找算法，与二叉搜索树的查找操作工作原理一致"
      }
    },
    {
      "id": "4:ac9ee535-5b37-44b2-a5d5-9955bff616ea:55",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "二叉搜索树的性质",
        "description": "左子树所有节点的值 < 根节点的值 < 右子树中所有节点的值；任意节点的左、右子树也是二叉搜索树"
      }
    },
    {
      "id": "4:ac9ee535-5b37-44b2-a5d5-9955bff616ea:59",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "插入节点",
        "description": "为保持左子树 < 根节点 < 右子树的性质，先查找插入位置，再在该位置插入节点；不允许重复节点，需借助 pre 保存上一轮循环节点"
      }
    }
