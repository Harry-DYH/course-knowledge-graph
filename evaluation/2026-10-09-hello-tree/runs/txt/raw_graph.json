      "id": "4:ac9ee535-5b37-44b2-a5d5-9955bff616ea:14",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "右子节点",
        "description": "节点的一个引用（指针），指向其右子节点。"
      }
    },
    {
      "id": "4:ac9ee535-5b37-44b2-a5d5-9955bff616ea:32",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "完满二叉树",
        "description": "除了叶节点之外，其余所有节点都有两个子节点"
      }
    },
    {
      "id": "4:ac9ee535-5b37-44b2-a5d5-9955bff616ea:28",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "插入与删除节点",
        "description": "与链表类似，在二叉树中插入与删除节点可以通过修改指针来实现；插入节点可能会改变二叉树的原有逻辑结构，删除节点通常意味着删除该节点及其所有子树"
      }
    },
    {
      "id": "4:ac9ee535-5b37-44b2-a5d5-9955bff616ea:27",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "初始化二叉树",
        "description": "与链表类似，首先初始化节点，然后构建引用（指针）"
      }
    },
    {
      "id": "4:ac9ee535-5b37-44b2-a5d5-9955bff616ea:37",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "深度",
        "description": "教材可能会将其定义为经过的节点的数量，此时高度和深度都需要加1"
      }
    },
    {
      "id": "4:ac9ee535-5b37-44b2-a5d5-9955bff616ea:31",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "完全二叉树",
        "description": "None只出现在最底层且靠右的位置，所有None一定出现在层序遍历序列的末尾。"
      }
    },
    {
      "id": "4:ac9ee535-5b37-44b2-a5d5-9955bff616ea:30",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "完美二叉树",
        "description": "二叉树的一个特例，所有层都被完全填满。"
      }
    },
    {
      "id": "4:ac9ee535-5b37-44b2-a5d5-9955bff616ea:35",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "链表",
        "description": "二叉树的最差结构，第i层节点数量为1，高度为h的树叶节点数量为1，节点总数为h+1，节点总数为n时高度为n-1"
      }
    },
    {
