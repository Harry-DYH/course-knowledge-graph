      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "常见二叉树类型",
        "description": "常见的二叉树类型，包括完美二叉树、完全二叉树、完满二叉树、平衡二叉树"
      }
    },
    {
