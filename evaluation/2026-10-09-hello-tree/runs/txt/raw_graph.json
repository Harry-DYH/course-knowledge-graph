      ],
      "properties": {
        "id": "父节点",
        "description": "拥有左子节点和右子节点的节点。"
      }
    },
    {
      "id": "4:ac9ee535-5b37-44b2-a5d5-9955bff616ea:11",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "二叉树",
        "description": "一种非线性数据结构，每个节点最多有两个子节点，可通过映射公式访问左、右子节点。"
      }
    },
    {
      "id": "4:ac9ee535-5b37-44b2-a5d5-9955bff616ea:25",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "节点的高度",
        "description": "从距离该节点最远的叶节点到该节点所经过的边的数量。"
      }
    },
    {
      "id": "4:ac9ee535-5b37-44b2-a5d5-9955bff616ea:20",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "边",
        "description": "连接两个节点的线段，即节点引用（指针）。"
      }
    },
