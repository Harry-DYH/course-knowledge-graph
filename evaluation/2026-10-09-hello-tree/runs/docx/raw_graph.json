      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "完全二叉树",
        "description": "None 只出现在最底层且靠右位置的二叉树，适合使用数组表示，可省略存储所有 None。"
      }
    },
    {
      "id": "4:90a7dcd3-ff6b-4621-9c53-069b5ec07138:26",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "二叉树基本操作",
        "description": "二叉树的基本操作，包括初始化、插入与删除节点等"
      }
    },
    {
      "id": "4:90a7dcd3-ff6b-4621-9c53-069b5ec07138:30",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "完美二叉树",
        "description": "二叉树的一个特例，所有层都被完全填满。"
      }
    },
    {
      "id": "4:90a7dcd3-ff6b-4621-9c53-069b5ec07138:33",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "平衡二叉树",
        "description": "任意节点的左子树和右子树的高度之差的绝对值不超过1"
      }
    },
    {
      "id": "4:90a7dcd3-ff6b-4621-9c53-069b5ec07138:34",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "二叉树的退化",
        "description": "当二叉树的每层节点都被填满时达到完美二叉树；当所有节点都偏向一侧时，二叉树退化为链表；链表情况下各项操作变为线性操作，时间复杂度退化至O(n)"
      }
    },
