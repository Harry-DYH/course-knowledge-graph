        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "左子节点",
        "description": "节点的一个引用（指针）所指向的子节点。"
      }
    },
    {
      "id": "4:90a7dcd3-ff6b-4621-9c53-069b5ec07138:19",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "叶节点",
        "description": "没有子节点的节点，其两个指针均指向 None。"
      }
    },
    {
      "id": "4:90a7dcd3-ff6b-4621-9c53-069b5ec07138:25",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "节点的高度",
        "description": "从距离该节点最远的叶节点到该节点所经过的边的数量。"
      }
    },
