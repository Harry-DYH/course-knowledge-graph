      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "初始化二叉树",
        "description": "与链表类似，首先初始化节点，然后构建引用（指针）"
      }
    },
    {
      "id": "4:90a7dcd3-ff6b-4621-9c53-069b5ec07138:35",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "链表",
        "description": "二叉树的最差结构，第i层节点数量为1，高度为h的树叶节点数量为1，节点总数为h+1"
      }
    },
    {
      "id": "4:90a7dcd3-ff6b-4621-9c53-069b5ec07138:32",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "完满二叉树",
        "description": "除了叶节点之外，其余所有节点都有两个子节点"
      }
    },
    {
      "id": "4:90a7dcd3-ff6b-4621-9c53-069b5ec07138:28",
      "labels": [
        "__Entity__",
        "Knowledgepoint"
      ],
      "properties": {
        "id": "插入与删除节点",
        "description": "与链表类似，在二叉树中插入与删除节点可以通过修改指针来实现；插入节点可能会改变二叉树的原有逻辑结构，删除节点通常意味着删除该节点及其所有子树"
      }
    },
